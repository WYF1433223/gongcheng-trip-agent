<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>TravelHarness</AssemblyName>
    <RootNamespace>TravelHarness</RootNamespace>
    <CodePage>65001</CodePage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\core\MiniJson.cs" />
    <Compile Include="..\core\Synth.cs" />
    <Compile Include="..\core\Rail.cs" />
    <Compile Include="..\core\Multimodal.cs" />
    <Compile Include="..\core\Data.cs" />
    <Compile Include="..\core\Model.cs" />
    <Compile Include="..\core\Verifier.cs" />
    <Compile Include="..\core\Planner.cs" />
    <Compile Include="..\core\Repair.cs" />
    <Compile Include="..\core\Engine.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>